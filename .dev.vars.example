# Radar Content — Environment Variables
# Copy this file to .dev.vars and fill in your values

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# X/Twitter API Bearer Token (optional)
# X_BEARER_TOKEN=your_x_bearer_token_here

# Reddit custom subreddits (comma-separated, optional override)
# REDDIT_SUBREDDITS=LocalLLaMA,ollama,MachineLearning,programming

# Crawl interval in minutes (default: 15)
# CRAWL_INTERVAL_MINUTES=15

# Admin Authentication & Google OAuth (optional)
# ADMIN_EMAIL=admin@example.com
# ADMIN_SECRET=your_admin_secret_password_here
# JWT_SECRET=your_random_jwt_secret_key_here
# GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
